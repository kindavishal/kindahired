[Unit]
Description=kindahired hub Telegram router
After=network.target

[Service]
User=kindahired
WorkingDirectory=/srv/kindahired/app
EnvironmentFile=/srv/kindahired/hub/router.env
ExecStart=/usr/bin/npx tsx src/hub/router.ts
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
