# Shared settings for every engine on the hub. Copy to /srv/kindahired/hub/hub.env (mode 600, owned by
# kindahired). Each kindahired-engine@ unit loads this file, then the person's own .env.
#
# Precedence, highest first:
#   1. The person's .env as systemd loads it (listed after this file, so it wins a clash).
#   2. This file.
#   3. Anything else config.ts loads (the repo .env, then DATA_DIR/.env again). config.ts never
#      overrides a variable that is already set, so it can't change what systemd set above.
# So leave these out of person files and everyone shares the hub's Google client and address. The
# one reason to set GOOGLE_CLIENT_ID/SECRET in a person's .env is the fallback where that person
# uses their own Google client (owner checklist, section 7, step 7).

# The "kindahired hub" Web application client from Google Cloud (owner checklist, section 7).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The hub's public address, with a trailing slash. Google's redirect URI is
# <JH_PUBLIC_URL>oauth/google/callback, and it must match the one registered on the client exactly.
JH_PUBLIC_URL=https://kindahired.kindavishal.dev/
