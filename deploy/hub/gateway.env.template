# Copy to <hub dir>/gateway.env (mode 600). From Cloudflare Zero Trust: the team domain, and the AUD
# tag of the self-hosted Access application for the hub's address.
CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
CF_ACCESS_AUD=

# The secret the gateway adds to every request it passes to an engine. Generate it once with
# `openssl rand -hex 32`; the same value goes in hub.env. The gateway won't start without it.
HUB_GATEWAY_SECRET=
