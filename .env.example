# How AI steps run (see README, "AI setup"):
#   hybrid  local model screens email; Claude Code on your Claude plan does packs (default, no API credit needed)
#   claude  everything through Claude Code
#   api     the Anthropic API, needs ANTHROPIC_API_KEY with credit
JH_AI=hybrid
# Free Gemini key from https://aistudio.google.com/apikey: makes screening and summaries fast
GEMINI_API_KEY=
JH_GEMINI_MODEL=gemini-3.5-flash-lite
JH_LOCAL_MODEL=qwen3:14b
ANTHROPIC_API_KEY=

# Telegram bot token from @BotFather. The chat id is filled in by `npm run jh -- telegram:link`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google OAuth client (Desktop app) for Gmail read-only and Sheets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your Google Sheet tracker (imported once, then kept as a mirror)
TRACKER_SHEET_ID=

# Your own email addresses, comma separated, so the tool knows which messages you sent
MY_EMAILS=

# Firecrawl web search (free plan, 1,000 credits a month, no card). Finds postings and profiles
# in seconds instead of a Claude Code web search. Leave empty to skip.
FIRECRAWL_API_KEY=
FIRECRAWL_MONTHLY_CREDITS=1000

# X API (pay per use, see README "X"). Read-only: posts, searches and your bookmarks.
# Bearer token, or the API key and secret: search, watched accounts and threads.
# Client id/secret: your bookmarks (run auth:x).
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Hard monthly cap in US dollars, spread evenly across the month
X_MONTHLY_BUDGET_USD=15

# Your time zone (IANA name, e.g. Europe/London). Leave empty to use this computer's.
JH_TIMEZONE=

# Dashboard port
PORT=4321
